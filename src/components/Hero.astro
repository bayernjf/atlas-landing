---
import { getLangFromUrl, useTranslations, localizePath } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const ctaHref = localizePath("/#cta", lang);
---

<section class="hero" id="top">
  <div class="shell hero__inner">
    <div class="hero__copy">
      <span class="hero__badge">
        <span class="led" data-c="loop" aria-hidden="true"></span>
        {t("hero.badge")}
      </span>
      <h1 class="hero__title">
        {t("hero.title.line1")}
        <span class="hero__title-accent">
          {t("hero.title.pre")}
          <span class="grad">{t("hero.title.accent")}</span>
          {t("hero.title.post")}
        </span>
      </h1>
      <p class="hero__sub">{t("hero.sub")}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={ctaHref}>{t("hero.cta.primary")}</a>
        <a class="btn btn--ghost" href="#pillars">{t("hero.cta.secondary")}</a>
      </div>
      <div class="hero__meta">
        <div class="hero__metric">
          <span class="hero__metric-num">7</span>
          <span class="hero__metric-label">{t("hero.meta.scenarios")}</span>
        </div>
        <div class="hero__metric">
          <span class="hero__metric-num">3</span>
          <span class="hero__metric-label">{t("hero.meta.demoScenes")}</span>
        </div>
        <div class="hero__metric">
          <span class="hero__metric-num">0</span>
          <span class="hero__metric-label">{t("hero.meta.noCode")}</span>
        </div>
      </div>
    </div>

    <!-- the operations grid: Harness / Graph / Loop joined as one runtime -->
    <div class="hero__viz" aria-label={t("hero.map.bar")} role="img">
      <div class="grid__bar">{t("hero.map.bar")}</div>
      <svg class="grid__svg" viewBox="0 0 460 300" fill="none">
        <!-- link lines -->
        <path d="M230 58 118 226" stroke="var(--graph)" stroke-width="1.4" opacity="0.35" stroke-dasharray="5 6" />
        <path d="M230 58l112 168" stroke="var(--harness)" stroke-width="1.4" opacity="0.35" stroke-dasharray="5 6" />
        <path d="M118 226l224 0" stroke="var(--loop)" stroke-width="1.4" opacity="0.35" stroke-dasharray="5 6" />
        <!-- Harness node -->
        <g>
          <circle cx="230" cy="58" r="34" stroke="var(--graph)" stroke-width="1.4" opacity="0.5" />
          <circle cx="230" cy="58" r="17" fill="var(--graph)" opacity="0.16" stroke="var(--graph)" />
          <text x="230" y="63" text-anchor="middle" class="grid__label">LOOP</text>
        </g>
        <!-- Graph node -->
        <g>
          <circle cx="118" cy="226" r="30" stroke="var(--harness)" stroke-width="1.4" opacity="0.5" />
          <circle cx="118" cy="226" r="15" fill="var(--harness)" opacity="0.16" stroke="var(--harness)" />
          <text x="118" y="231" text-anchor="middle" class="grid__label">HARNESS</text>
        </g>
        <!-- Loop node -->
        <g>
          <circle cx="342" cy="226" r="30" stroke="var(--loop)" stroke-width="1.4" opacity="0.5" />
          <circle cx="342" cy="226" r="15" fill="var(--loop)" opacity="0.16" stroke="var(--loop)" />
          <text x="342" y="231" text-anchor="middle" class="grid__label">GRAPH</text>
        </g>
        <!-- orbit ticks -->
        <g class="grid__ticks" stroke="var(--ink-faint)" stroke-width="1">
          <line x1="10" y1="30" x2="10" y2="36" />
          <line x1="450" y1="30" x2="450" y2="36" />
          <line x1="10" y1="270" x2="10" y2="276" />
          <line x1="450" y1="270" x2="450" y2="276" />
        </g>
      </svg>
      <div class="grid__legend">
        <span><i class="led led--dot" data-c="harness"></i>{t("hero.legend.harness")}</span>
        <span><i class="led led--dot" data-c="graph"></i>{t("hero.legend.graph")}</span>
        <span><i class="led led--dot" data-c="loop"></i>{t("hero.legend.loop")}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 88px 0 72px;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 12px;
    border: 1px solid var(--steel-600);
    border-radius: 999px;
    background: var(--steel-900);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
  }
  .hero__title {
    margin-top: 22px;
    font-size: clamp(40px, 5.4vw, 62px);
    letter-spacing: -0.025em;
  }
  .hero__title-accent {
    display: block;
    color: var(--ink-dim);
  }
  .grad {
    background: linear-gradient(92deg, var(--graph), var(--harness) 55%, var(--loop));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero__sub {
    margin-top: 20px;
    max-width: 34em;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-dim);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }
  .hero__meta {
    display: flex;
    gap: 40px;
    margin-top: 42px;
    padding-top: 26px;
    border-top: 1px solid var(--steel-700);
  }
  .hero__metric-num {
    display: block;
    font-family: var(--mono);
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
  }
  .hero__metric-label {
    display: block;
    margin-top: 7px;
    font-size: 12px;
    color: var(--ink-faint);
  }

  /* viz */
  .hero__viz {
    position: relative;
    border: 1px solid var(--steel-600);
    background: var(--steel-900);
    box-shadow: var(--bevel);
    padding: 12px 14px 14px;
  }
  .grid__bar {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--ink-faint);
    padding-bottom: 8px;
  }
  .grid__svg {
    width: 100%;
    height: auto;
  }
  .grid__label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    fill: var(--ink-dim);
  }
  .grid__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
  }
  .grid__legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 980px) {
    .hero__inner { grid-template-columns: 1fr; gap: 40px; }
    .hero { padding: 60px 0 48px; }
  }
  @media (max-width: 640px) {
    .hero__meta { gap: 26px; }
    .hero__title { font-size: 36px; }
  }
</style>
