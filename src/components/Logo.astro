---
// Atlas brand mark: three nodes (Harness / Graph / Loop) joined into one
// triangle — a single runtime built from three primitives.
---

<svg
  class="logo"
  width="22"
  height="22"
  viewBox="0 0 24 24"
  fill="none"
  role="img"
  aria-label="Atlas"
>
  <circle cx="12" cy="3.5" r="2.4" fill="var(--graph, #ffb020)" />
  <circle cx="4.5" cy="19" r="2.4" fill="var(--harness, #35e0f0)" />
  <circle cx="19.5" cy="19" r="2.4" fill="var(--loop, #66e07a)" />
  <path
    d="M12 5.9 5.1 17.3M12 5.9l6.9 11.4M6.2 19h11.6"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linecap="round"
    opacity="0.55"
  />
</svg>

<style>
  .logo {
    display: block;
    width: var(--logo-size, 22px);
    height: var(--logo-size, 22px);
    color: var(--ink-dim, #8ea2ad);
  }
</style>
