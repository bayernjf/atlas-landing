---
import Logo from "./Logo.astro";
import { getLangFromUrl, useTranslations } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pillars = [
  {
    key: "harness",
    color: "var(--harness)",
    title: t("pillars.harness.title"),
    role: t("pillars.harness.role"),
    body: t("pillars.harness.body"),
    example: t("pillars.harness.example"),
  },
  {
    key: "graph",
    color: "var(--graph)",
    title: t("pillars.graph.title"),
    role: t("pillars.graph.role"),
    body: t("pillars.graph.body"),
    example: t("pillars.graph.example"),
  },
  {
    key: "loop",
    color: "var(--loop)",
    title: t("pillars.loop.title"),
    role: t("pillars.loop.role"),
    body: t("pillars.loop.body"),
    example: t("pillars.loop.example"),
  },
];
---

<section class="pillars" id="pillars">
  <div class="shell">
    <header class="sec-head" data-reveal>
      <span class="sec-head__kicker">{t("pillars.kicker")}</span>
      <h2 class="sec-head__title">{t("pillars.title")}</h2>
      <p class="sec-head__sub">{t("pillars.sub")}</p>
    </header>

    <div class="pillars__grid">
      {
        pillars.map((p) => (
          <article class="card" data-reveal style={`--acc: ${p.color}`}>
            <div class="card__top">
              <Logo />
              <div>
                <h3 class="card__title">{p.title}</h3>
                <span class="card__role">{p.role}</span>
              </div>
            </div>
            <p class="card__body">{p.body}</p>
            <p class="card__example">
              <span class="card__example-tag">→</span>
              {p.example}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    padding: 72px 0 60px;
    background: var(--steel-900);
  }
  .sec-head {
    max-width: 40em;
    margin-bottom: 40px;
  }
  .sec-head__kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--ink-faint);
  }
  .sec-head__title {
    margin-top: 12px;
    font-size: clamp(28px, 3.6vw, 40px);
  }
  .sec-head__sub {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-dim);
  }
  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .card {
    border: 1px solid var(--steel-600);
    background: var(--steel-850);
    box-shadow: var(--bevel);
    padding: 26px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card__top {
    display: flex;
    align-items: center;
    gap: 12px;
    --logo-size: 26px;
  }
  .card__top :global(.logo) {
    color: var(--acc);
  }
  .card__title {
    font-size: 19px;
  }
  .card__role {
    display: block;
    margin-top: 2px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--acc);
  }
  .card__body {
    font-size: 14px;
    line-height: 1.8;
    color: var(--ink-dim);
  }
  .card__example {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px dashed var(--steel-600);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink-faint);
  }
  .card__example-tag {
    color: var(--acc);
    font-family: var(--mono);
  }

  @media (max-width: 980px) {
    .pillars__grid { grid-template-columns: 1fr; }
  }
</style>
