---
import { getLangFromUrl, useTranslations } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const scenes = [
  { key: "a", title: t("scenarios.a.title"), body: t("scenarios.a.body"), n: "01" },
  { key: "b", title: t("scenarios.b.title"), body: t("scenarios.b.body"), n: "02" },
  { key: "c", title: t("scenarios.c.title"), body: t("scenarios.c.body"), n: "03" },
];
---

<section class="scenes" id="scenarios">
  <div class="shell">
    <header class="sec-head" data-reveal>
      <span class="sec-head__kicker">{t("scenarios.kicker")}</span>
      <h2 class="sec-head__title">{t("scenarios.title")}</h2>
      <p class="sec-head__sub">{t("scenarios.sub")}</p>
    </header>

    <div class="scenes__list">
      {
        scenes.map((s) => (
          <article class="scene" data-reveal>
            <span class="scene__n">{s.n}</span>
            <div class="scene__inner">
              <h3 class="scene__title">{s.title}</h3>
              <p class="scene__body">{s.body}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="scenes__more" data-reveal>{t("scenarios.more")}</p>
  </div>
</section>

<style>
  .scenes {
    padding: 72px 0 60px;
  }
  .sec-head {
    max-width: 40em;
    margin-bottom: 40px;
  }
  .sec-head__kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--ink-faint);
  }
  .sec-head__title {
    margin-top: 12px;
    font-size: clamp(28px, 3.6vw, 40px);
  }
  .sec-head__sub {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-dim);
  }
  .scenes__list {
    display: grid;
    gap: 14px;
  }
  .scene {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 22px;
    align-items: start;
    padding: 24px 26px;
    border: 1px solid var(--steel-600);
    background: var(--steel-850);
    box-shadow: var(--bevel);
  }
  .scene__n {
    font-family: var(--mono);
    font-size: 22px;
    font-weight: 800;
    color: var(--ink-faint);
    padding-top: 2px;
  }
  .scene__title {
    font-size: 19px;
  }
  .scene__body {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--ink-dim);
  }
  .scenes__more {
    margin-top: 22px;
    padding: 14px 26px;
    border-left: 3px solid var(--graph);
    background: var(--steel-900);
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-dim);
  }

  @media (max-width: 640px) {
    .scene { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
